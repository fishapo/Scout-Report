{
  "name": "scout-report",
  "version": "2.3.1",
  "description": "Pest and disease scout reporting for agricultural farms with PostgreSQL backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node --test server/*.test.js server/**/*.test.js previews/*.test.js previews/**/*.test.js",
    "verify": "node server/scripts/verify.js",
    "dev:watch": "nodemon --legacy-watch server/index.js",
    "verify:ui": "node scripts/verify-admin-dashboard.js",
    "verify:phase1": "node scripts/verify-phase1.js",
    "verify:phase2": "node scripts/verify-phase2.js",
    "verify:phase3": "node scripts/verify-phase3.js",
    "verify:phase4": "node scripts/verify-phase4.js",
    "verify:phase5": "node scripts/verify-phase5.js",
    "verify:phase6": "node scripts/verify-phase6.js",
    "verify:phase7": "node scripts/verify-phase7.js",
    "verify:phase8": "node scripts/verify-phase8.js",
    "verify:phase9": "node scripts/verify-phase9.js",
    "release:check": "npm run verify:phase19",
    "verify:phase10": "node scripts/verify-phase10.js",
    "verify:phase11": "node scripts/verify-phase11.js",
    "verify:phase12": "node scripts/verify-phase12.js",
    "release:artifact": "bash scripts/build-release-artifact.sh",
    "verify:phase13": "node scripts/verify-phase13.js",
    "smoke:staging": "bash scripts/staging-smoke.sh",
    "verify:phase14": "node scripts/verify-phase14.js",
    "verify:phase15": "node scripts/verify-phase15.js",
    "verify:phase16": "node scripts/verify-phase16.js",
    "report:slo": "node scripts/generate-slo-report.js",
    "review:reliability": "node scripts/generate-reliability-review.js",
    "verify:phase17": "node scripts/verify-phase17.js",
    "verify:phase18": "node scripts/verify-phase18.js",
    "verify:phase18:local": "node scripts/verify-phase18.js --local",
    "verify:phase19": "node scripts/verify-phase19.js",
    "verify:phase19:local": "node scripts/verify-phase19.js --local",
    "pretest": "node scripts/verify-dependencies.js",
    "verify:dependencies": "node scripts/verify-dependencies.js",
    "migrate": "node server/scripts/migrate.js",
    "verify:admin-management": "node scripts/verify-admin-management.js",
    "verify:admin-ui": "node scripts/verify-admin-dashboard.js && node scripts/verify-admin-management.js",
    "verify:phase20": "node scripts/verify-phase20.js",
    "verify:phase21": "node scripts/verify-phase21.js",
    "verify:auth-fix": "node server/auth-regression.test.js && node scripts/verify-auth-fix.js",
    "verify:phase22": "node scripts/verify-phase22.js",
    "verify:hod-workflow": "node scripts/verify-hod-workflow.js",
    "verify:master-import": "node scripts/verify-master-import.js",
    "verify:phase23": "node scripts/verify-phase23.js",
    "verify:phase25": "node --test previews/master-reference.test.js",
    "verify:latest-form": "node --test previews/master-reference.test.js server/master-form-alignment.test.js",
    "verify:phase26": "node scripts/verify-phase26.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agriculture",
    "scouting",
    "pest-management",
    "postgresql"
  ],
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "packageManager": "npm@10.9.2"
}
