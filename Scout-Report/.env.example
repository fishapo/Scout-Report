# Scout Report local environment template
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=5432
DB_NAME=scout_report
DB_USER=scout_user
DB_PASSWORD=replace-with-your-local-db-password

JWT_SECRET=replace-with-a-long-random-development-secret
JWT_TTL_SECONDS=28800
ENFORCE_HTTPS=false
