# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Authentication
# Generate a long, random value for every deployment. Never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_SECONDS=28800

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=scout_report
DB_USER=scout_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Set only when the application is behind a trusted reverse proxy.
TRUST_PROXY_HOPS=0

# Enable database-backed tests explicitly.
RUN_DB_INTEGRATION=0
RUN_DB_TESTS=0
