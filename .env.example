NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scout_report
DB_USER=scout_user
DB_PASSWORD=scout_password

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_SECONDS=28800

# Azure App Service terminates TLS and forwards protocol headers.
ENFORCE_HTTPS=true
