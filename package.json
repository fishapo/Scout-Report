{
  "name": "scout-report",
  "version": "2.0.0",
  "description": "Pest and disease scout reporting for agricultural farms with PostgreSQL backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:clean": "node scripts/kill-port.js && node --watch server/index.js",
    "test": "node --test",
    "verify": "node server/scripts/verify.js",
    "migrate": "node server/scripts/migrate.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agriculture",
    "scouting",
    "pest-management",
    "postgresql"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "get-port": "^7.2.0",
    "pg": "^8.11.3"
  }
}
